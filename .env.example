# Worker configuration
# Copy to .env and fill in values

# Required: API connection
ANISEKAI_API_URL=http://localhost:8080
ANISEKAI_API_KEY=

# Optional: Worker identity and behavior
WORKER_NAME=worker-1
WORKER_FACTORIES=media:convert
WORKER_POLL_INTERVAL=10s
WORKER_HEARTBEAT_INTERVAL=60s
WORKER_CONNECT_TIMEOUT=10s
WORKER_READ_TIMEOUT=300s
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_DELAY=1s
WORKER_SCRATCH_DIR=/tmp/anisekai-worker
WORKER_CONVERSION_TIMEOUT=3h
WORKER_LOG_LEVEL=INFO

# Logging levels
LOG_APPLICATION_LEVEL=INFO
LOG_API_LEVEL=WARN
LOG_LIBRARY_LEVEL=WARN
LOG_FRAMEWORK_LEVEL=WARN

# Optional: Sentry (if enabled)
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=worker